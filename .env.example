# ---- AI provider (server-side only, never expose) ----
# Any OpenAI-compatible provider works. OpenRouter example:
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your_api_key_here
# Fast and affordable default. Use openai/gpt-5 or openai/gpt-5-pro for higher quality (slower, costlier).
AI_MODEL=openai/gpt-5-mini

# ---- Supabase (required for Google sign-in and saved history) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Site URL (optional on Vercel, which provides VERCEL_PROJECT_PRODUCTION_URL) ----
# Set to your custom domain once you have one, e.g. https://runon.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000
